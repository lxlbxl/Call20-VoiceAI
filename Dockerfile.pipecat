# Call20 Pipecat Voice Agent Dockerfile
# Installs PyAV from pre-built wheels to avoid FFmpeg dev library compilation (saves memory)
FROM python:3.11-slim

WORKDIR /app

# Install FFmpeg runtime libraries only (no dev headers - PyAV wheels include what they need)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libavutil59 \
    libavcodec59 \
    libavformat59 \
    libswresample4 \
    libswscale6 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY pipecat/requirements.txt .

# Install PyAV first from pre-built wheel (av>=11.0 has manylinux wheels)
# This avoids needing FFmpeg dev headers for compilation
RUN pip install --no-cache-dir "av>=11.0,<14.0"

# Install remaining dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY pipecat/ .

# Run as non-root user
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Expose ports (voice agent + SIP gateway)
EXPOSE 8765 8766

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8765/health || exit 1

# Start both services
CMD ["python", "voice_agent.py"]