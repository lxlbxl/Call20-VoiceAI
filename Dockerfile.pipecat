# Call20 Pipecat Voice Agent Dockerfile
# Uses python:3.11-bookworm with all build dependencies
# CACHE_BUST: 2026-05-05-v7 - force full rebuild
FROM python:3.11-bookworm

# Install FFmpeg, build dependencies, and system libraries
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libavdevice-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev \
    libpq5 \
    gcc \
    g++ \
    python3-dev \
    libffi-dev \
    pkg-config \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy constraints and requirements
# Constraints force av==11.0.0 which has pre-built manylinux wheels
# aiortc (pulled by pipecat-ai extras) requires av<12.0 which av==11.0.0 satisfies
# --no-build-isolation ensures constraints are respected during builds
COPY pipecat/constraints.txt .
COPY pipecat/requirements.txt .
RUN pip install --no-cache-dir --no-build-isolation -c constraints.txt -r requirements.txt

# Copy application
COPY pipecat/ .

# Run as non-root user
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Expose ports (voice agent + SIP gateway)
EXPOSE 8765 8766

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8765/health || exit 1

# Start both services
CMD ["python", "voice_agent.py"]