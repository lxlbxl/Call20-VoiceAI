# Call20 Pipecat Voice Agent Dockerfile
# Uses python:3.11-slim + apt ffmpeg (lightweight, no OOM risk)
FROM python:3.11-slim

# Install FFmpeg and system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ffmpeg \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install Python dependencies
COPY pipecat/requirements.txt .

# Install PyAV (will use system FFmpeg)
RUN pip install --no-cache-dir "av>=11.0,<14.0"

# Install remaining dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY pipecat/ .

# Run as non-root user
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Expose ports (voice agent + SIP gateway)
EXPOSE 8765 8766

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8765/health || exit 1

# Start both services
CMD ["python", "voice_agent.py"]