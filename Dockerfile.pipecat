# Call20 Pipecat Voice Agent Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install build tools first (small package, low memory)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install PostgreSQL client library (small)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install FFmpeg libraries one at a time to reduce memory pressure
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libavutil-dev \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libswresample-dev \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libswscale-dev \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libavcodec-dev \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libavformat-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY pipecat/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY pipecat/ .

# Run as non-root user
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Expose ports (voice agent + SIP gateway)
EXPOSE 8765 8766

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8765/health || exit 1

# Start both services
CMD ["python", "voice_agent.py"]