# Call20 Pipecat Voice Agent Dockerfile
# Uses jrottenberg/ffmpeg base image with FFmpeg pre-installed
# This avoids ALL FFmpeg library installation during build (no OOM risk)
FROM jrottenberg/ffmpeg:latest AS ffmpeg-base

# Use Python slim and copy FFmpeg from the ffmpeg image
FROM python:3.11-slim

# Copy FFmpeg binaries and libraries from ffmpeg-base
COPY --from=ffmpeg-base /usr/local/bin /usr/local/bin
COPY --from=ffmpeg-base /usr/local/lib /usr/local/lib
COPY --from=ffmpeg-base /usr/local/include /usr/local/include
COPY --from=ffmpeg-base /usr/local/share /usr/local/share

# Set library path for FFmpeg
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

WORKDIR /app

# Install only PostgreSQL client library and curl (minimal)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY pipecat/requirements.txt .

# Install PyAV from pre-built wheel (it will use the copied FFmpeg)
RUN pip install --no-cache-dir "av>=11.0,<14.0"

# Install remaining dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY pipecat/ .

# Run as non-root user
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Expose ports (voice agent + SIP gateway)
EXPOSE 8765 8766

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8765/health || exit 1

# Start both services
CMD ["python", "voice_agent.py"]