    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/knowledge-bases/layout,_N_T_/dashboard/knowledge-bases/page,_N_T_/dashboard/knowledge-bases"
  },
